			<0x330 0x80001f 0x800003>,
			<0x334 0x8080001f 0x80800003>,
			<0x338 0x80001f 0x800003>,
			<0x33c 0x80001f 0x800003>,
			<0x340 0x80001f 0x800003>,
			<0x344 0x80001f 0x800003>,
			<0x348 0x80001f 0x800003>,
			<0x34c 0x80001f 0x800003>,
			<0x350 0x80001f 0x800003>,
			<0x404 0xffff0023 0x1d0021>,
			<0x408 0x3ff 0xd>,
			<0x40c 0x700003ff 0xc>,
			<0x410 0x8000001f 0x80000001>,
			<0x414 0x8000001f 0x80000001>,
			<0x418 0x8000001f 0x80000001>,
			<0x41c 0x8000001f 0x80000001>,
			<0x420 0x8000001f 0x80000003>,
			<0x424 0x8000001f 0x80000003>,
			<0x428 0x8000001f 0x80000003>,
			<0x42c 0x8000001f 0x80000003>,
			<0x430 0x8000001f 0x80000003>,
			<0x434 0x8000001f 0x80000003>,
			<0x438 0x8000001f 0x80000003>,
			<0x43c 0x8000001f 0x80000003>,
			<0x440 0x8000001f 0x80000003>,
			<0x444 0x8000001f 0x80000003>,
			<0x448 0x8000001f 0x80000003>,
			<0x44c 0x8000001f 0x80000003>,
			<0x450 0x8000001f 0x80000003>,
			<0x948 0x7ff07ff 0x280000>,
			<0xa48 0x7ff07ff 0x400040>,
			<0xb48 0x7ff07ff 0xb8010e>,
			<0xc48 0x7ff07ff 0x400020>,
			<0xd48 0x7ff07ff 0x8a008a>,
			<0x1000 0xffffffff 0x7fffffff>,
			<0x1004 0x100 0x100>,
			<0x4008 0x1 0x1>,
			<0x400c 0x1 0x1>,
			<0x4014 0x1 0x1>,
			<0x4018 0x1 0x0>,
			<0x401c 0x1 0x1>,
			<0x108 0xffff0007 0x100001>;
		apple,tunable-atc-pll =
			<0xa04 0x7c 0x50>,
			<0x3224 0xc00 0x800>,
			<0x3230 0x1f 0xf>,
			<0x3240 0x7d8007f 0x4000029>,
			<0x32b0 0xb800000 0x1800000>,
			<0x32e8 0x60001 0x40001>,
			<0x3338 0xf800000 0x7800000>;
		apple,tunable-atc-axi2af-lioa =
			<0x28 0xfc2f 0x0>,
			<0x2c 0x7 0x0>,
			<0x30 0xff 0x0>,
			<0x34 0x3ff 0x0>,
			<0x58 0x30b 0x0>;
		apple,tunable-atc-lanes =
			<0xb698 0x7e00000 0x4400000>,
			<0xb69c 0x7e00000 0x3800000>,
			<0xb6a0 0x7e00000 0x3800000>,
			<0xd094 0x80000 0x80000>,
			<0xd098 0x80000 0x80000>,
			<0xd0a4 0x800000 0x800000>,
			<0xd0a8 0x200000 0x200000>,
			<0x1b698 0x7e00000 0x4400000>,
			<0x1b69c 0x7e00000 0x3800000>,
			<0x1b6a0 0x7e00000 0x3800000>,
			<0x1d094 0x80000 0x80000>,
			<0x1d098 0x80000 0x80000>,
			<0x1d0a4 0x800000 0x800000>,
			<0x1d0a8 0x200000 0x200000>;
	};

	dwc3_1: usb@2aa280000 {
		compatible = "generic-xhci";
		reg = <0x2 0xaa280000 0x0 0x8000>;
		interrupts = <AIC_IRQ 1451 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&dwc3_1_dart_0 0>, <&dwc3_1_dart_1 1>;
		power-domains = <&ps_atc1_usb>;
		phys = <&usb2phy_1>;
		phy-names = "usb2-phy";
	};

	dwc3_1_dart_0: iommu@2aaf00000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		reg = <0x2 0xaaf00000 0x0 0xc000>;
		interrupts = <AIC_IRQ 1455 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_atc1_usb>;
		#iommu-cells = <1>;
		apple,dma-range = <0x100 0x4000 0 0xffff0000>;
	};

	dwc3_1_dart_1: iommu@2aaf80000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		reg = <0x2 0xaaf80000 0x0 0xc000>;
		interrupts = <AIC_IRQ 1455 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_atc1_usb>;
		#iommu-cells = <1>;
		apple,dma-range = <0x100 0x4000 0 0xffff0000>;
	};

	usb2phy_2: phy@382a90000 {
		compatible = "apple,t6050-usb2-phy";
		reg = <0x3 0x82a90000 0x0 0x4000>, <0x3 0x82a84000 0x0 0x4000>,
		      <0x3 0x82280000 0x0 0x11800>;
		reg-names = "usb2phy", "pipehandler", "core";
		#phy-cells = <0>;
		power-domains = <&ps_atc2_usb>;
	};

	dwc3_2: usb@382280000 {
		compatible = "generic-xhci";
		reg = <0x3 0x82280000 0x0 0x8000>;
		interrupts = <AIC_IRQ 1483 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&dwc3_2_dart_0 0>, <&dwc3_2_dart_1 1>;
		power-domains = <&ps_atc2_usb>;
		phys = <&usb2phy_2>;
		phy-names = "usb2-phy";
	};

	dwc3_2_dart_0: iommu@382f00000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		reg = <0x3 0x82f00000 0x0 0xc000>;
		interrupts = <AIC_IRQ 1487 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_atc2_usb>;
		#iommu-cells = <1>;
		apple,dma-range = <0x100 0x4000 0 0xffff0000>;
	};

	dwc3_2_dart_1: iommu@382f80000 {
		compatible = "apple,t6050-dart", "apple,t8110-dart";
		reg = <0x3 0x82f80000 0x0 0xc000>;
		interrupts = <AIC_IRQ 1487 IRQ_TYPE_LEVEL_HIGH>;
		power-domains = <&ps_atc2_usb>;
		#iommu-cells = <1>;
		apple,dma-range = <0x100 0x4000 0 0xffff0000>;
	};
};
