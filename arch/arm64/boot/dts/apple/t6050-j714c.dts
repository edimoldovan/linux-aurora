/*
 * Apple MacBook Pro (14-inch, M5 Max, 18 CPU cores)
 *
 * target-type: J714c
 *
 * Initial RAM boot resources measured on J714c/T6050.
 * The loader supplies usable memory, CPU release addresses and
 * framebuffer geometry. Peripheral power domains come from
 * t6050-pmgr.dtsi; the framebuffer holds the display domain.
 *
 * The loader's command line MUST include maxcpus=1 for the first boot:
 * spin-table bring-up of the secondaries is blocked by the T6050
 * firmware-parking problem under investigation (dumps/HANDOFF.md),
 * and arm64 spin-table waits unboundedly for each CPU to check in.
 *
 * Copyright The Asahi Linux Contributors
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/apple-aic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>

#include "t6050.dtsi"
#include "t6050-smc.dtsi"

/ {
	compatible = "apple,j714c", "apple,t6050", "apple,arm-platform";
	model = "Apple MacBook Pro (14-inch, M5 Max, 18 CPU cores)";

	#address-cells = <2>;
	#size-cells = <2>;
	interrupt-parent = <&aic>;

	aliases {
		gpu = &gpu;
		keyboard = &keyboard;
		serial0 = &serial0;
		/* kboot fills the N1's factory addresses from /chosen through these */
		wifi0 = &n1_alpha;
		bluetooth0 = &n1_beta;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		stdout-path = "serial0:1500000n8";

		framebuffer0: framebuffer@0 {
			compatible = "apple,simple-framebuffer", "simple-framebuffer";
			reg = <0 0 0 0>; /* Filled by the loader. */
			status = "okay"; /* m1n1 only enables it on chips it knows. */
			power-domains = <&ps_disp_cpu>;
			apple,internal-panel; /* simpledrm reports it as eDP */
		};
	};

	memory@10000000000 {
		device_type = "memory";
		reg = <0x100 0 0 0>; /* Filled by the loader. */
	};

	led-controller {
		compatible = "pwm-leds";
		led-0 {
			pwms = <&fpwm0 0 40000>;
			label = "kbd_backlight";
			function = LED_FUNCTION_KBD_BACKLIGHT;
			color = <LED_COLOR_ID_WHITE>;
			max-brightness = <255>;
			default-state = "keep";
		};
	};
};

&fpwm0 {
	status = "okay";
};

&mtp {
	status = "okay";
};

&mtp_mbox {
	status = "okay";
};

&mtp_dart {
	status = "okay";
};

&mtp_dockchannel {
	status = "okay";
};

&mtp_hid {
	mtp_mt: multi-touch {
		firmware-name = "apple/tpmtfw-j714c.bin";
		apple,power-method = <2>;
		apple,firmware-managed-reset;
	};

	keyboard: keyboard {
		hid-country-code = <0>;
		apple,keyboard-layout-id = <0>;
	};

	stm {
	};

	actuator {
	};

	tp_accel {
	};
};
#include "t6050-j714c-usb2.dtsi"

/* Enable the GPU and its mailboxes; the loader disables them again if the ADT
 * perf/region data does not validate (dt_set_gpu_g17). */
&gfx_mbox {
	status = "okay";
};

&gfx1_mbox {
	status = "okay";
};

&gpu {
	status = "okay";
};

#include "hwmon-common.dtsi"
#include "hwmon-fan-dual.dtsi"
#include "hwmon-laptop.dtsi"

/*
 * The T6050 SMC spells the fan mode keys F0md/F1md; F0Md/F1Md from
 * hwmon-fan*.dtsi do not exist (as on J714s in omarchy-m5).
 */
&smc_hwmon {
	fan-F0Ac {
		apple,fan-mode = "F0md";
	};

	fan-F1Ac {
		apple,fan-mode = "F1md";
	};
};

/*
 * Audio: the amplifiers and the jack codec on I2C; the I2S side is the
 * AOP's (below).
 *
 * ADT /arm-io/i2c1: audio-speaker 0x38 (the primary amp, holds
 * speaker-config), audio-speaker-left-woofer-2 0x39, audio-speaker-left-
 * tweeter 0x3a. /arm-io/i2c3: audio-speaker-right-woofer-1 0x3b,
 * audio-speaker-right-woofer-2 0x3c, audio-speaker-right-tweeter 0x3d. All
 * six are sn012776. /arm-io/i2c2: audio-codec-output 0x4b, cs42l84, the
 * headphone jack.
 *
 * Lines, all on gpio0 (pinctrl_ap): amps share shutdown GPIO 107
 * (function-reset GPIO(0x6b)) and interrupt 106; codec reset GPIO 139
 * (function-reset GPIO(0x8b)), interrupt 134. Speaker-id GPIOs 136/137 are
 * unused. Polarities follow the in-tree J516 and the J716s reference:
 * active-high shutdown and reset, level-low interrupts; the ADT flag words
 * (0x10001 amps, 0x1 codec) are not decoded.
 *
 * Sense slots: speaker-config row n is the amp the ADT names speakerN
 * (audio-speaker, then speaker1..speaker5 = LW1 RW1 LW2 RW2 LT RT); amp n
 * carries I in slot 4n and V in slot 4n+2, the tas2764/J516 convention
 * (the ADT labels the two the other way round).
 *
 * T6050 has no AP-side MCA: the I2S ports and their power domains belong
 * to the AOP firmware (ADT /arm-io/iop-audio-controller, AOPAudioService,
 * streams on admac-base-ns), and t8140_aop_audio's T6050 variant provides
 * the CPU DAIs for the sound node below, as on T8140. The amps leave
 * hardware shutdown only from the ASoC component probe, so the shared
 * shutdown line stays low until the card binds.
 */
&pinctrl_ap {
	status = "okay";
};

&i2c1 {
	status = "okay";

	speaker_left_woof1: codec@38 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x38>;
		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 1";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <0>;
		ti,vmon-slot-no = <2>;
	};

	speaker_left_woof2: codec@39 {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x39>;
		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Woofer 2";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <8>;
		ti,vmon-slot-no = <10>;
	};

	speaker_left_tweet: codec@3a {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3a>;
		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Left Tweeter";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <16>;
		ti,vmon-slot-no = <18>;
	};
};

&i2c2 {
	status = "okay";

	jack_codec: codec@4b {
		compatible = "cirrus,cs42l84";
		reg = <0x4b>;
		reset-gpios = <&pinctrl_ap 139 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		interrupts-extended = <&pinctrl_ap 134 IRQ_TYPE_LEVEL_LOW>;
		sound-name-prefix = "Jack";
	};
};

&i2c3 {
	status = "okay";

	speaker_right_woof1: codec@3b {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3b>;
		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 1";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <4>;
		ti,vmon-slot-no = <6>;
	};

	speaker_right_woof2: codec@3c {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3c>;
		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Woofer 2";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <12>;
		ti,vmon-slot-no = <14>;
	};

	speaker_right_tweet: codec@3d {
		compatible = "ti,sn012776", "ti,tas2764";
		reg = <0x3d>;
		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
		#sound-dai-cells = <0>;
		sound-name-prefix = "Right Tweeter";
		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
		ti,imon-slot-no = <20>;
		ti,vmon-slot-no = <22>;
	};
};

/*
 * AOP: the co-processor, its mailbox, the base-ns ADMAC and the audio
 * streams. The sound card: the jack on the AOP's cout/cin streams, the six
 * amps on its spkr stream (ADT order, amp-tx-zd-config rows 0 and 1 as the
 * idle masks), speakers off by default in the j714 macaudio config.
 */
&aop_dart {
	status = "okay";
};

&aop_mbox {
	status = "okay";
};

&aop_setup_mbox {
	status = "okay";
};

&aop {
	status = "okay";
};

&aop_audio {
	apple,chassis-name = "J714";
	apple,machine-kind = "MacBook Pro";
};

&admac_base_ns {
	status = "okay";
};

&admac_leap_s {
	status = "okay";
};

/ {
	sound: sound {
		compatible = "apple,j714-macaudio", "apple,macaudio";
		model = "MacBook Pro J714";
		#address-cells = <1>;
		#size-cells = <0>;

		dai-link@0 {
			reg = <0>;
			link-name = "Headphone Jack";

			cpu {
				sound-dai = <&aop_audio 0>;
			};
			codec {
				sound-dai = <&jack_codec>;
			};
		};

		dai-link@1 {
			reg = <1>;
			link-name = "Speakers";
			dai-tdm-idle-mode-0 = "zero";
			dai-tdm-idle-mode-1 = "zero";
			dai-tdm-slot-tx-idle-mask-0 = <0xf0f0f0>;
			dai-tdm-slot-tx-idle-mask-1 = <0x0f0f0f>;

			cpu {
				sound-dai = <&aop_audio 4>;
			};
			codec {
				sound-dai = <&speaker_left_woof1>,
					    <&speaker_right_woof1>,
					    <&speaker_left_woof2>,
					    <&speaker_right_woof2>,
					    <&speaker_left_tweet>,
					    <&speaker_right_tweet>;
			};
		};
	};
};

/*
 * The N1 (Wi-Fi and Bluetooth) on apcie0 port 0, as aurora-silicon's t6050-j716c.dts names it;
 * the J714c has the same port, registers and pins (ADT 2026-11-05). iBoot leaves the port
 * untrained and the N1 off (SMC GPIO gP13 low, PERST# GPIO 80 low); the kernel trains it.
 * Platform id = (board-id 0x0a << 16) | 0x6050 by aurora's J716c rule; the FTAB comes from the
 * macOS install (not shipped by aurora).
 */
&pcie0 {
	reg = <0x1c 0xb0000000 0x0 0x10000000>,
	      <0x4 0x14000000 0x0 0x4000>,
	      <0x4 0x10028000 0x0 0x8000>,
	      <0x4 0x17010000 0x0 0x4000>,
	      <0x4 0x10024000 0x0 0x4000>,
	      <0x4 0x17020000 0x0 0x4000>,
	      <0x4 0x17004000 0x0 0x4000>;
	/* phy-shared: ADT reg[3]; phy-common: ADT reg[2] + 0x4000 */
	reg-names = "config", "rc", "port0", "phy0", "intr2axi0", "phy-shared", "phy-common";
	interrupts = <AIC_IRQ 1523 IRQ_TYPE_LEVEL_HIGH>;
	interrupt-names = "port0";

	/* The N1's three functions are on DART streams 1-3 */
	iommu-map = <0x100 &dart_apcie0 1 3>;
	bus-range = <0 4>;

	port00: pci@0,0 {
		device_type = "pci";
		reg = <0x0 0 0 0 0>;
		bus-range = <1 1>;
		apple,link-trained-by-bootloader;
		/* PERST#, for the kernel's train and the root-port reset after the N1's ROM stage */
		reset-gpios = <&pinctrl_ap 80 GPIO_ACTIVE_LOW>;
		/* The N1's power/reset: ADT function-reset = pKW4('gP13', ...), SMC GPIO pin 0x13 */
		pwren-gpios = <&smc_gpio 19 GPIO_ACTIVE_HIGH>;
		status = "okay";

		#address-cells = <3>;
		#size-cells = <2>;
		ranges;

		interrupt-controller;
		#interrupt-cells = <1>;
		interrupt-map-mask = <0 0 0 7>;
		interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
				<0 0 0 2 &port00 0 0 0 1>,
				<0 0 0 3 &port00 0 0 0 2>,
				<0 0 0 4 &port00 0 0 0 3>;

		n1_control: control@0,0 {
			compatible = "pci106b,1900";
			reg = <0x10000 0x0 0x0 0x0 0x0>;
			firmware-name = "apple/centauri/j714c-ftab.bin";
			apple,centauri-platform-id = <0x000a6050>;
			apple,centauri-protocol = <27>;
		};

		n1_alpha: wifi@0,1 {
			compatible = "pci106b,1902";
			reg = <0x10100 0x0 0x0 0x0 0x0>;
			local-mac-address = [00 00 00 00 00 00];
		};

		n1_beta: bluetooth@0,2 {
			compatible = "pci106b,1903";
			reg = <0x10200 0x0 0x0 0x0 0x0>;
			local-bd-address = [00 00 00 00 00 00];
		};
	};
};

&dart_apcie0 {
	status = "okay";
};
