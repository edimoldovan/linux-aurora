# Minimal RAM-only J714c (T6050, M5 Max MacBook Pro 14-inch) bring-up; use with
# KCONFIG_ALLCONFIG and allnoconfig. Derived from j813.config; the kernel boots to a
# shell with keyboard on one core (maxcpus=1).
CONFIG_LOCALVERSION="-j714c-ARCH"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_ARCH_APPLE=y
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_VA_BITS_47=y
CONFIG_SMP=y
CONFIG_NR_CPUS=18
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_ARM64_VHE=y
CONFIG_ARM64_SVE=y
CONFIG_ARM64_PAN=y
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_KALLSYMS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_SERIAL_APPLE_DOCKCHANNEL=y
CONFIG_SERIAL_APPLE_DOCKCHANNEL_EARLYCON=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_APPLE=y
CONFIG_RUST=y
CONFIG_DRM_ASAHI=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
CONFIG_LOG_BUF_SHIFT=20
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PM=y
CONFIG_MAILBOX=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_RTKIT_HELPER=y
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_APPLE_DART=y
CONFIG_MFD_MACSMC=y
CONFIG_HWMON=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_HID_APPLE=y
CONFIG_HID_MAGICMOUSE=y
CONFIG_GPIOLIB=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_PWM=y
CONFIG_PWM=y
CONFIG_PWM_APPLE=y
CONFIG_FW_LOADER=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_SPMI=y
CONFIG_SPMI_APPLE=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_APPLE=y
CONFIG_USB_HID=y
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
# Boot through U-Boot and Limine as an EFI application (EFI stub, /sys/firmware/efi)
CONFIG_EFI=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_TYPEC=y
CONFIG_TYPEC_SN201202X=y
CONFIG_PHY_APPLE_ATC=y
CONFIG_PHY_APPLE_T6050_USB2=y
CONFIG_DEBUG_FS=y
# T6050 CPU features and errata
CONFIG_ARM64_SME=y
CONFIG_ARM64_LSUI=y
CONFIG_ARM64_ERRATUM_4193714=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_APPLE=y
CONFIG_APPLE_SART=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_APPLE_WATCHDOG=y
CONFIG_WATCHDOG_SYSFS=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_BTRFS_FS=y
# systemd
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
# Rust reads task_struct: bindgen drops the alignment of an empty sched_statistics, so without
# SCHEDSTATS every Rust field offset after it is 40 bytes early (statistics stay off at run time)
CONFIG_SCHEDSTATS=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_BLK_CGROUP=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_FHANDLE=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_AUTOFS_FS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_SHA256=y
CONFIG_BPF_SYSCALL=y
CONFIG_FS_POSIX_ACL=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_BINFMT_MISC=y
CONFIG_OVERLAY_FS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_CHECKPOINT_RESTORE=y
# sysctl and pseudo filesystems for systemd/udev
CONFIG_SYSCTL=y
CONFIG_PROC_SYSCTL=y
CONFIG_CONFIGFS_FS=y
CONFIG_SECURITYFS=y
CONFIG_KALLSYMS=y
# file locking, keys, pressure info
CONFIG_FILE_LOCKING=y
CONFIG_KEYS=y
CONFIG_PROC_CHILDREN=y
CONFIG_PSI=y
CONFIG_DNOTIFY=y
# cpufreq: let the scheduler pick the clock; performance for tests
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE is not set
CONFIG_CPU_FREQ_STAT=y
# USB-C host: PD controller, network adapters
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_TYPEC_TPS6598X=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_AX8817X=y
# bring-up: dyndbg= on the command line
CONFIG_DYNAMIC_DEBUG=y
# Omarchy root: zram swap (zram-generator) and Landlock (pacman's download sandbox)
CONFIG_SWAP=y
CONFIG_BLK_DEV=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_SECURITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock"
# SMC children: lid and power button, RTC (offset in the PMIC NVMEM), GPIO
CONFIG_NVMEM=y
CONFIG_NVMEM_APPLE_SPMI=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_MACSMC=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_MACSMC_INPUT=y
CONFIG_GPIO_MACSMC=y
# Sleep: s2idle when the lid closes; PM_DEBUG gives /sys/power/pm_test for driver sleep tests
CONFIG_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# Battery and charger (SMC)
CONFIG_MACSMC_POWER=y
# Power-off and restart through the SMC (MBSE off1/phra)
CONFIG_POWER_RESET_MACSMC=y
# Firewall: Omarchy's ufw (iptables-nft) needs netfilter, nf_tables and the xtables matches it uses.
CONFIG_NETFILTER=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_HL=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_TARGET_REJECT=y
CONFIG_IP6_NF_MATCH_RT=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_PCI=y
# Audio, stage A: the AP GPIO block (codec reset, shutdown and interrupt
# lines), I2C buses 1-3, the six sn012776 speaker amps and the cs42l84 jack
# codec. No sound card yet: T6050 has no AP-side MCA, the I2S ports belong to
# the AOP firmware, so no machine driver. GPIO_CDEV for gpioinfo on the Mac.
CONFIG_PINCTRL=y
CONFIG_PINCTRL_APPLE_GPIO=y
CONFIG_GPIO_CDEV=y
CONFIG_I2C_APPLE=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y
CONFIG_SND_SOC_TAS2764=y
CONFIG_SND_SOC_CS42L84=y
# The six amps share shutdown GPIO 107: gpiolib hands shared lines out
# through the proxy chip, without which every consumer defers forever.
CONFIG_GPIO_SHARED_PROXY=y
# Machine driver, for the apple,j714-macaudio config (speakers off, -30 dB
# ceiling). Inert until a sound node with a CPU DAI exists.
CONFIG_SND_SOC_APPLE_MACAUDIO=y
# AOP (always-on processor), step 1 of the audio bring-up: the co-processor,
# its setup port and the base-ns audio DMA. Rust, RTKit and mailbox are on.
CONFIG_APPLE_AOP=y
CONFIG_DMADEVICES=y
CONFIG_APPLE_ADMAC=y
# Step 2: the AOP audio streams (CPU DAIs for the amps and the jack).
CONFIG_SND_SOC_APPLE_T8140_AOP_AUDIO=y
CONFIG_SND_PROC_FS=y
# Kernel defaults the working builds had on, which allnoconfig turns off: the RTC setting
# the clock at boot, netfilter's advanced matches, ethtool netlink, PCIe ASPM, firmware cache.
CONFIG_AF_UNIX_OOB=y
CONFIG_APPLE_PMP=y
CONFIG_APPLE_PMP_REPORT=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_BQL=y
CONFIG_ETHTOOL_NETLINK=y
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_FONT_8x16=y
CONFIG_FONT_8x8=y
CONFIG_FW_CACHE=y
CONFIG_FW_LOADER_DEBUG=y
CONFIG_INET_DIAG=y
CONFIG_INTEGRITY=y
CONFIG_IPV6_SIT=y
CONFIG_MAC80211_STA_HASH_MAX_SIZE=0
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_EGRESS=y
CONFIG_NETFILTER_INGRESS=y
CONFIG_NET_FLOW_LIMIT=y
CONFIG_NETWORK_FILESYSTEMS=y
CONFIG_NVMEM_SYSFS=y
CONFIG_OVERLAY_FS_REDIRECT_ALWAYS_FOLLOW=y
CONFIG_PCIEASPM_DEFAULT=y
CONFIG_PCIEASPM=y
CONFIG_PCI_QUIRKS=y
CONFIG_PCPU_DEV_REFCNT=y
CONFIG_RAID6_PQ_BENCHMARK=y
CONFIG_RFS_ACCEL=y
CONFIG_RPS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_INTF_DEV=y
CONFIG_RTC_INTF_PROC=y
CONFIG_RTC_INTF_SYSFS=y
CONFIG_RTC_NVMEM=y
CONFIG_RTC_SYSTOHC_DEVICE="rtc0"
CONFIG_RTC_SYSTOHC=y
CONFIG_RUST_OVERFLOW_CHECKS=y
CONFIG_SND_PCI=y
CONFIG_SND_VERBOSE_PROCFS=y
CONFIG_TIME_NS=y
CONFIG_USB_ARMLINUX=y
CONFIG_USB_BELKIN=y
CONFIG_USB_DWC3_HAPS=y
CONFIG_USB_NET_CDC_SUBSET=y
CONFIG_USB_NET_NET1080=y
CONFIG_USB_NET_ZAURUS=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_PCI_ASMEDIA=y
CONFIG_VGA_ARB_MAX_GPUS=16
CONFIG_VGA_ARB=y
CONFIG_WATCHDOG_HANDLE_BOOT_ENABLED=y
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_NF_CT_PROTO_SCTP=y
CONFIG_I2C_CHARDEV=y
# Wi-Fi and Bluetooth: the N1 on apcie0 port 0, through aurora-silicon's T6050 PCIe adopt
# path (apple,t6050-pcie; the port is trained before Linux) and its centauri driver.
CONFIG_PCIE_APPLE=y
CONFIG_CFG80211=y
CONFIG_WLAN_VENDOR_APPLE=y
CONFIG_APPLE_CENTAURI=y
CONFIG_APPLE_CENTAURI_WIFI=y
CONFIG_BT=y
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_HCICENTAURI=y
CONFIG_RFKILL=y
# iwd, the Wi-Fi service NetworkManager uses on Omarchy, exits at start unless every one of these
# is in the kernel (iwd src/main.c check_crypto: AF_ALG hashes and ciphers, the keyring, the parsers).
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_MD5=y
CONFIG_CRYPTO_SHA1=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_DES=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CBC=y
CONFIG_KEYS=y
CONFIG_KEY_DH_OPERATIONS=y
CONFIG_ASYMMETRIC_KEY_TYPE=y
CONFIG_ASYMMETRIC_PUBLIC_KEY_SUBTYPE=y
CONFIG_X509_CERTIFICATE_PARSER=y
CONFIG_PKCS7_MESSAGE_PARSER=y
CONFIG_PKCS8_PRIVATE_KEY_PARSER=y
# iwd warns at start without MD4 (EAP-MSCHAPv2 needs it).
CONFIG_CRYPTO_MD4=y
# cfg80211 is built in and asks for regulatory.db before the root is mounted; carry the signed
# database in the kernel (from the build host's /lib/firmware, the wireless-regdb package).
CONFIG_EXTRA_FIRMWARE="regulatory.db regulatory.db.p7s"
# tailscaled's normal mode: the /dev/net/tun interface
CONFIG_TUN=y
# The ISP (camera): V4L2 and the apple-isp driver
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_MEDIA_PLATFORM_DRIVERS=y
CONFIG_VIDEO_DEV=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_APPLE_ISP=y
# The video decoder (AVD), built in like the rest: its firmware goes in the initramfs
CONFIG_VIDEO_APPLE_AVD=y
