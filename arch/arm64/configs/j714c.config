# Minimal RAM-only J714c (T6050, M5 Max MacBook Pro 14-inch) bring-up; use with
# KCONFIG_ALLCONFIG and allnoconfig. Derived from j813.config; the kernel boots to a
# shell with keyboard on one core (maxcpus=1).
CONFIG_LOCALVERSION="-aurora-j714c-wip"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_ARCH_APPLE=y
CONFIG_ARM64_16K_PAGES=y
CONFIG_ARM64_VA_BITS_47=y
CONFIG_SMP=y
CONFIG_NR_CPUS=18
CONFIG_CPU_FREQ=y
CONFIG_CPU_FREQ_STAT=y
CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE=y
CONFIG_CPU_FREQ_GOV_USERSPACE=y
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
CONFIG_ARM64_VHE=y
CONFIG_ARM64_SVE=y
CONFIG_ARM64_PAN=y
CONFIG_ARM64_LSE_ATOMICS=y
CONFIG_EXPERT=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_POSIX_TIMERS=y
CONFIG_KALLSYMS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_SHMEM=y
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_SERIAL_APPLE_DOCKCHANNEL=y
CONFIG_SERIAL_APPLE_DOCKCHANNEL_EARLYCON=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_FB=y
CONFIG_FB_DEVICE=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_APPLE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_DRM_FBDEV_EMULATION=y
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
CONFIG_LOG_BUF_SHIFT=20
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_PM=y
CONFIG_MAILBOX=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_RTKIT_HELPER=y
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_IOMMU_SUPPORT=y
CONFIG_APPLE_DART=y
CONFIG_MFD_MACSMC=y
CONFIG_HWMON=y
CONFIG_SENSORS_MACSMC_HWMON=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_HID_APPLE=y
CONFIG_HID_MAGICMOUSE=y
CONFIG_GPIOLIB=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_PWM=y
CONFIG_PWM=y
CONFIG_PWM_APPLE=y
CONFIG_FW_LOADER=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_APPLE_PMGR_PWRSTATE=y
CONFIG_SPMI=y
CONFIG_SPMI_APPLE=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_APPLE=y
CONFIG_USB_HID=y
CONFIG_BLOCK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXFAT_FS=y
CONFIG_NLS_UTF8=y
CONFIG_TYPEC=y
CONFIG_TYPEC_SN201202X=y
CONFIG_PHY_APPLE_ATC=y
CONFIG_DEBUG_FS=y
# T6050 CPU features and errata
CONFIG_ARM64_SME=y
CONFIG_ARM64_LSUI=y
CONFIG_ARM64_ERRATUM_4193714=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_APPLE=y
CONFIG_APPLE_SART=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_APPLE_WATCHDOG=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_BTRFS_FS=y
# systemd
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_BLK_CGROUP=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_FHANDLE=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SYSVIPC=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_AUTOFS_FS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_SHA256=y
CONFIG_BPF_SYSCALL=y
CONFIG_FS_POSIX_ACL=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_BINFMT_MISC=y
CONFIG_OVERLAY_FS=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_AIO=y
CONFIG_IO_URING=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_CHECKPOINT_RESTORE=y
# sysctl and pseudo filesystems for systemd/udev
CONFIG_SYSCTL=y
CONFIG_PROC_SYSCTL=y
CONFIG_CONFIGFS_FS=y
CONFIG_SECURITYFS=y
CONFIG_KALLSYMS=y
# file locking, keys, pressure info
CONFIG_FILE_LOCKING=y
CONFIG_KEYS=y
CONFIG_PROC_CHILDREN=y
CONFIG_PSI=y
CONFIG_DNOTIFY=y
# cpufreq: let the scheduler pick the clock; performance for tests
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_GOV_PERFORMANCE=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
# CONFIG_CPU_FREQ_DEFAULT_GOV_USERSPACE is not set
CONFIG_CPU_FREQ_STAT=y
# USB-C host: PD controller, network adapters
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_ETHERNET=y
CONFIG_TYPEC_TPS6598X=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_AX8817X=y
